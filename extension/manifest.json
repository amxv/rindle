{
  "manifest_version": 3,
  "name": "Rindle History Sync",
  "description": "Private two-way URL history synchronization with Safari on your Mac and iPhone.",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["history", "nativeMessaging", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rindle history sync"
  }
}
