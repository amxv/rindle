---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Rust-first",
    body: "A single Rust 2024 crate with clap, tests, and a pinned toolchain. No framework or runtime beyond the CLI itself."
  },
  {
    title: "Direct distribution",
    body: "cargo-dist is configured for macOS, Linux, and Windows archives, checksum files, and native installers. No npm package."
  },
  {
    title: "Simple development",
    body: "Format, Clippy, tests, and builds are exposed through a small Justfile and standard Cargo commands."
  },
  {
    title: "Independent docs",
    body: "Astro and ZueDocs live under docs/. GitHub Actions deploys documentation only when the docs change."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Early-stage project</p>
      <h1>Rindle.</h1>
      <p class="hero__lede">
        A minimal Rust CLI foundation. The application commands are still to come;
        the build, test, documentation, and direct-release infrastructure is in place.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs">Browse docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Development</p>
      <div class="hero__terminal">
        <span>$ just check-fast</span>
        <span>$ cargo run -- --help</span>
        <span>$ just docs-dev</span>
        <span>$ dist plan</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Baseline</p>
      <h2>The foundation is ready. The product comes next.</h2>
      <p>
        Rindle currently ships no application-specific behavior. Source code stays in Rust,
        release configuration lives in dist-workspace.toml, and the site lives in docs/.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Setup, development, and release documentation.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
