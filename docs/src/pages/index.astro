---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Your iPhone, your Mac",
    body: "Use Safari on your phone and Dia on your desktop. Rindle quietly connects their URL suggestions through iCloud."
  },
  {
    title: "History, not page loads",
    body: "Rindle adds history records directly. It never reopens the websites you visited to manufacture suggestions."
  },
  {
    title: "No browser babysitting",
    body: "A tiny background job syncs every few hours. Dia catches up the next time you open it, with no extra clicks."
  },
  {
    title: "Only on your devices",
    body: "A local Rust helper and Chromium extension work with Apple's existing iCloud sync. No Rindle cloud or accounts."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Private browser history sync for macOS</p>
      <h1>Rindle.</h1>
      <p class="hero__lede">
        Safari on your iPhone. Dia on your Mac. One history everywhere.
        Rindle quietly brings visited links to both address bars, without reopening your pages.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs">Browse docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Getting started</p>
      <div class="hero__terminal">
        <span>$ rindle setup --browser dia</span>
        <span>$ rindle status</span>
        <span>$ rindle sync --dry-run</span>
        <span>$ rindle sync</span>
      </div>
      <p class="hero__panel-label">Currently in local testing. First release coming after acceptance.</p>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Designed to disappear</p>
      <h2>All your links. No extra work.</h2>
      <p>
        Keep browsing exactly the way you already do. Rindle uses a lightweight Rust CLI,
        a Chromium extension, and the iCloud sync you already have.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Setup, development, and release documentation.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
